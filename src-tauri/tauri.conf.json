{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebClaw Upgrader",
  "version": "0.2.0",
  "identifier": "com.land007.webclaw-upgrader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WebClaw 升级中心",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "WebClaw 容器内软件升级与进程管理",
    "longDescription": "扫描 webclaw 容器内已安装软件，检测新版本并一键升级；同时提供 supervisor 进程状态板。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "resources": [
      "../software-manifest.json"
    ]
  }
}
